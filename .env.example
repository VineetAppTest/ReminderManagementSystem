# RemindIQ feedback repository provider
# Allowed: firebase, supabase, sheets
VITE_FEEDBACK_PROVIDER=firebase

# Firebase Firestore feedback repository
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_FEEDBACK_COLLECTION=remindiq_feedback_items

# Supabase fallback
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_FEEDBACK_TABLE=remindiq_feedback_items

# Google Sheets webhook fallback
VITE_SHEETS_FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
